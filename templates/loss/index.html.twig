{% extends 'base.html.twig' %}

{% block title %}Pertes{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('styles/pages/listing.css') }}">
{% endblock %}

{% block body %}
    <div class="content-shell">
        <h1 class="page-title">Pertes</h1>

        {% if pertes is empty %}
            <div class="empty-state">Aucune perte enregistree pour le moment.</div>
        {% else %}
            <div class="table-card">
                <table>
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Produit</th>
                            <th>Quantite</th>
                            <th>Raison</th>
                            <th>Date</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for perte in pertes %}
                            <tr>
                                <td>{{ perte.id }}</td>
                                <td>{{ perte.produit.nom }}</td>
                                <td>{{ perte.quantite }}</td>
                                <td>{{ perte.raison }}</td>
                                <td>{{ perte.datePerte ? perte.datePerte|date('d/m/Y H:i') : '-' }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </div>
{% endblock %}